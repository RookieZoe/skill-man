{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "library-browser",
  "description": "Library Desk command surface with no frontend filesystem or shell plugin access.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
