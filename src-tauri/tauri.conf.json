{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Man",
  "version": "0.1.1",
  "identifier": "io.github.rookiezoe.skillman",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skill Man",
        "width": 1280,
        "height": 760,
        "minWidth": 1280,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["library-browser"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/RookieZoe/skill-man/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNkI1NDkwQTE3NjkxNkMKUldSc2tYYWhrRlJyekltTlV3b3BiQVV1M0oxbjI0WkZQM25Xb1A2dzh0VlBBK0lSSzRVY29wYnAK"
    }
  }
}
