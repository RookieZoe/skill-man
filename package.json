{
  "name": "skill-man",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "matrix:layout": "vite --port 1420 --open '/?matrix=layout'",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:release": "node --test scripts/release/*.node-test.mjs",
    "test:watch": "vitest",
    "ci:local": "node scripts/ci-local.mjs",
    "ci:local:clean": "npm ci && npm run ci:local",
    "lint": "eslint . --max-warnings 0",
    "check:capabilities": "node --test scripts/check-capabilities.node-test.mjs && node scripts/check-capabilities.mjs",
    "check:locales": "node --test scripts/check-locales.node-test.mjs && node scripts/check-locales.mjs",
    "format": "prettier --write package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts eslint.config.js index.html src scripts resources .github src-tauri/tauri.conf.json src-tauri/tauri.release.conf.json src-tauri/capabilities",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts eslint.config.js index.html src scripts resources .github src-tauri/tauri.conf.json src-tauri/tauri.release.conf.json src-tauri/capabilities",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
